// Everything the Worker needs lives here, so Workers Builds (git) can deploy it with no login.
// Secrets (IP_SALT, TURNSTILE_SECRET) are NOT stored here: set them in the dashboard (see README).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name you pick in the dashboard when connecting the repo.
  "name": "glosse-guestbook",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // Static files from public/. Only /api/* is sent to the Worker first.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guestbook",
      // ⬇ Paste the Database ID from the dashboard (D1 → guestbook → Settings/Overview).
      "database_id": "PASTE-YOUR-D1-DATABASE-ID-HERE"
    }
  ],

  // Public (not secret). Fill in the Turnstile *site key* to turn the widget on; leave "" to skip.
  // It only has an effect if the TURNSTILE_SECRET secret is also set.
  "vars": { "TURNSTILE_SITEKEY": "" },

  "observability": { "enabled": true }
}
